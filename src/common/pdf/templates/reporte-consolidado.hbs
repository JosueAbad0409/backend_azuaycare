<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <title>Reporte Consolidado</title>
  <style>
    :root {
      color-scheme: light;
      font-family: 'Segoe UI', Arial, sans-serif;
      color: #1f2937;
      background: #ffffff;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 24px;
      background: #f4f6f8;
    }

    .page {
      max-width: 1080px;
      margin: 0 auto;
      background: #fff;
      padding: 32px;
      border-radius: 14px;
      box-shadow: 0 18px 50px rgba(15, 23, 42, 0.08);
    }

    .brand-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      gap: 16px;
    }

    .brand-bar .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-bar .brand .brand-mark {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      background: linear-gradient(135deg, #1d4ed8, #10375c);
      color: #fff;
      font-weight: 800;
      font-size: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      letter-spacing: 0.04em;
    }

    .brand-bar .brand h1 {
      margin: 0;
      font-size: 24px;
      letter-spacing: 0.02em;
      color: #10375c;
    }

    .brand-bar .brand small {
      color: #475569;
      display: block;
      margin-top: 4px;
    }

    .document-meta {
      text-align: right;
      color: #475569;
      font-size: 12px;
    }

    .document-meta strong {
      color: #0f172a;
    }

    .banner-signature {
      margin: 24px 0;
      padding: 18px 20px;
      background: #eff6ff;
      border-left: 6px solid #1d4ed8;
      border-radius: 10px;
    }

    .banner-signature p {
      margin: 0;
      line-height: 1.5;
      font-size: 13px;
      color: #1e293b;
    }

    .section {
      margin-top: 28px;
    }

    .section-title {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 18px;
    }

    .section-title .number {
      color: #1d4ed8;
      font-size: 18px;
      font-weight: 700;
    }

    .section-title h2 {
      margin: 0;
      font-size: 18px;
      letter-spacing: 0.01em;
      color: #0f172a;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .card {
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 16px;
      background: #fbfdff;
    }

    .card strong {
      display: block;
      font-size: 12px;
      color: #475569;
      margin-bottom: 6px;
    }

    .card span {
      font-size: 18px;
      font-weight: 700;
      color: #0f172a;
    }

    .label-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .label-item {
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 12px 14px;
      background: #ffffff;
    }

    .label-item strong {
      display: block;
      font-size: 11px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #334155;
      margin-bottom: 8px;
    }

    .label-item span {
      display: block;
      font-size: 14px;
      color: #0f172a;
      font-weight: 600;
    }

    .table-wrapper {
      overflow-x: auto;
    }

    /* 🔥 table-layout ya NO es "fixed": el número de columnas ahora es
       dinámico (depende de las columnas que el coordinador seleccione),
       así que dejamos que el navegador reparta el ancho automáticamente. */
    table {
      width: 100%;
      border-spacing: 0;
      border-collapse: collapse;
      margin-top: 12px;
      table-layout: auto;
    }

    th,
    td {
      padding: 6px 5px;
      text-align: left;
      border-bottom: 1px solid #e2e8f0;
      font-size: 9px;
      word-break: break-word;
      vertical-align: top;
    }

    th {
      background: #1d4ed8;
      color: #ffffff;
      font-weight: 700;
      font-size: 8.5px;
      white-space: nowrap;
    }

    tbody tr:hover {
      background: rgba(59, 130, 246, 0.05);
    }

    .footer {
      margin-top: 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      color: #475569;
      font-size: 12px;
    }

    .signature-block {
      width: 320px;
      border-top: 1px solid #cbd5e1;
      padding-top: 10px;
      text-align: center;
      color: #0f172a;
      font-weight: 600;
    }

    @media print {
      body {
        background: #fff;
      }

      .page {
        box-shadow: none;
        border-radius: 0;
        margin: 0;
        padding: 16px;
      }

      .brand-bar,
      .banner-signature,
      .footer {
        page-break-inside: avoid;
      }

      table th,
      table td {
        font-size: 8px;
        padding: 4px 3px;
      }

      .card-grid,
      .label-grid {
        gap: 8px;
      }
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="brand-bar">
      <div class="brand">
        <div class="brand-mark">AC</div>
        <div>
          <h1>AzuayCare</h1>
          <small>Ficha Socioeconómica - Vista Impresa</small>
        </div>
      </div>
      <div class="document-meta">
        <div><strong>Periodo:</strong> {{periodo}}</div>
        <div><strong>Generado:</strong> {{generated_at}}</div>
      </div>
    </div>

    <div class="banner-signature">
      <p><strong>Firma Digital y Consentimiento:</strong> Documento de uso oficial. El contenido presentado en este
        reporte representa el estado de la ficha socioeconómica y puede ser validado mediante firma digital
        institucional.</p>
    </div>

    <div class="section">
      <div class="section-title">
        <div class="number">I</div>
        <h2>Resumen ejecutivo</h2>
      </div>
      <div class="card-grid">
        <div class="card">
          <strong>Total registros</strong>
          <span>{{total_registros}}</span>
        </div>
        <div class="card">
          <strong>Total fichas analizadas</strong>
          <span>{{total_fichas_respondidas}}</span>
        </div>
        <div class="card">
          <strong>Filtros aplicados</strong>
          <span>{{#if filtros.estado_ficha}}{{filtros.estado_ficha}}{{else}}Todos{{/if}}</span>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section-title">
        <div class="number">II</div>
        <h2>Parámetros del Reporte</h2>
      </div>
      <div class="label-grid">
        <div class="label-item">
          <strong>Periodo</strong>
          <span>{{periodo}}</span>
        </div>
        <div class="label-item">
          <strong>Formulario</strong>
          <span>{{filtros.formulario_nombre}}</span>
        </div>
        <div class="label-item">
          <strong>Carrera</strong>
          <span>{{filtros.carrera_nombre}}</span>
        </div>
        <div class="label-item">
          <strong>Ciclo</strong>
          <span>{{filtros.ciclo_nombre}}</span>
        </div>
        <div class="label-item">
          <strong>Estado ficha</strong>
          <span>{{#if filtros.estado_ficha}}{{filtros.estado_ficha}}{{else}}Todos{{/if}}</span>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section-title">
        <div class="number">III</div>
        <h2>Datos de la muestra</h2>
      </div>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              {{#each columnas}}
              <th>{{this.etiqueta}}</th>
              {{/each}}
            </tr>
          </thead>
          <tbody>
            {{#each dataset}}
            <tr>
              {{#each this.valores}}
              <td>{{this}}</td>
              {{/each}}
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

    <div class="footer">
      <div>Documento generado por la plataforma AzuayCare.</div>
      <div class="signature-block">Firma digital autorizada</div>
    </div>
  </div>
</body>

</html>