<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    .pregunta, .info-box, h2 { page-break-inside: avoid; }
    body { font-family: 'Helvetica', sans-serif; color: #333; margin: 0; padding: 20px; }
    .header { text-align: center; border-bottom: 3px solid {{plantilla.color_primario}}; padding-bottom: 10px; margin-bottom: 20px; }
    .header img { max-height: 60px; }
    h1 { color: {{plantilla.color_primario}}; font-size: 20px; margin-bottom: 5px; }
    .form-titulo { font-size: 16px; color: #555; margin-top: 0; }
    .form-descripcion { font-size: 12px; color: #777; margin-bottom: 15px; }
    h2 { color: {{plantilla.color_secundario}}; font-size: 16px; border-bottom: 1px solid #ccc; padding-bottom: 5px; margin-top: 30px; }
    .info-box { background-color: #f9f9f9; padding: 15px; border-radius: 5px; margin-bottom: 20px; border-left: 5px solid {{plantilla.color_primario}}; font-size: 13px; }
    .alert-box { background-color: #fff3f3; padding: 15px; border-radius: 5px; margin-bottom: 20px; border-left: 5px solid #d9534f; font-size: 13px; color: #a94442; }
    .pregunta { margin-bottom: 10px; font-size: 12px; }
    .pregunta b { display: block; color: #444; }
    .respuesta { margin-top: 3px; color: #111; background: #eee; padding: 5px; border-radius: 3px; }
    .footer { position: fixed; bottom: 0; width: 100%; text-align: center; font-size: 10px; color: #888; border-top: 1px solid #eee; padding-top: 10px; }
  </style>
</head>
<body>
  <div class="header">
    {{#if plantilla.logo_url}}<img src="{{plantilla.logo_url}}" alt="Logo">{{/if}}
    <h1>{{plantilla.encabezado}}</h1>
    <div class="form-titulo">{{formulario.titulo}}</div>
    {{#if formulario.descripcion}}<div class="form-descripcion">{{formulario.descripcion}}</div>{{/if}}
  </div>

  <div class="info-box">
    <strong>Estudiante:</strong> {{ficha.usuario.primer_nombre}} {{ficha.usuario.primer_apellido}} <br>
    <strong>Cédula:</strong> {{ficha.usuario.cedula}} <br>
    <strong>Periodo:</strong> {{ficha.periodo.nombre}} <br>
    <strong>Fecha de envío:</strong> {{formatDate ficha.created_at}} <br>
    <strong>Estado:</strong> {{ficha.estado_ficha}}
  </div>

  {{#if esFichaFinanciera}}
  <div class="info-box" style="border-left-color: {{plantilla.color_secundario}};">
    <strong>Total Ingresos:</strong> {{formatCurrency ficha.total_ingresos}} |
    <strong>Total Egresos:</strong> {{formatCurrency ficha.total_egresos}} <br>
    <strong>Balance Calculado:</strong> {{formatCurrency ficha.balance_final}} <br>
    <strong>Clasificación Asignada:</strong> {{#if ficha.rangoResultado}}{{ficha.rangoResultado.nombre}}{{else}}En evaluación{{/if}}
  </div>
  {{/if}}

  {{#if requiereAtencionSalud}}
  <div class="alert-box">
    <strong>⚠️ Atención Prioritaria (NEE / Salud):</strong><br>
    {{#if tieneDiscapacidad}} - Presenta carnet de discapacidad registrado.<br>{{/if}}
    {{#if usaLentes}} - Requiere apoyo visual (lentes).<br>{{/if}}
    {{#if enfermedadCronica}} - Condición médica reportada: {{enfermedadCronica}}<br>{{/if}}
  </div>
  {{/if}}

  {{#each secciones}}
  <h2>{{this.nombre}}</h2>
  {{#each this.preguntas}}
    <div class="pregunta">
      <b>{{this.enunciado}}</b>
      <div class="respuesta">{{{this.respuestaHtml}}}</div>
    </div>
  {{/each}}
  {{/each}}

  <div class="footer">{{plantilla.pie_pagina}}</div>
</body>
</html>