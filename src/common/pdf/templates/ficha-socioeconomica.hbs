<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'Helvetica', Arial, sans-serif;
      color: #1e293b;
      margin: 0;
      padding: 28px 32px 48px;
      font-size: 12px;
      line-height: 1.45;
    }
    .header {
      text-align: center;
      border-bottom: 3px solid {{plantilla.color_primario}};
      padding-bottom: 14px;
      margin-bottom: 22px;
    }
    .header img { max-height: 56px; margin-bottom: 8px; }
    h1 {
      color: {{plantilla.color_primario}};
      font-size: 20px;
      margin: 0 0 4px;
      letter-spacing: -0.02em;
    }
    .form-titulo { font-size: 14px; color: #475569; margin: 0; font-weight: 600; }
    .form-descripcion { font-size: 11px; color: #94a3b8; margin-top: 4px; }

    h2 {
      color: {{plantilla.color_primario}};
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-left: 4px solid {{plantilla.color_primario}};
      padding: 6px 0 6px 10px;
      margin: 28px 0 14px;
      background: #f8fafc;
      border-radius: 0 6px 6px 0;
    }

    .info-box {
      background: #f8fafc;
      padding: 14px 16px;
      border-radius: 8px;
      margin-bottom: 14px;
      border-left: 4px solid {{plantilla.color_primario}};
      font-size: 12px;
    }
    .info-box strong { color: #0f172a; }

    .alert-box {
      background: #fef2f2;
      padding: 12px 14px;
      border-radius: 8px;
      margin-bottom: 16px;
      border-left: 4px solid #dc2626;
      font-size: 12px;
      color: #991b1b;
    }

    .pregunta {
      margin-bottom: 12px;
      page-break-inside: avoid;
    }
    .pregunta b {
      display: block;
      color: #64748b;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin-bottom: 4px;
      font-weight: 700;
    }
    .respuesta {
      color: #0f172a;
      background: #f1f5f9;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid #e2e8f0;
      font-size: 12px;
      font-weight: 600;
    }
    .respuesta img {
      page-break-inside: avoid;
      margin-top: 6px;
    }

    .footer {
      position: fixed;
      bottom: 12px;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 9px;
      color: #94a3b8;
      border-top: 1px solid #e2e8f0;
      padding-top: 8px;
    }
  </style>
</head>
<body>
  <div class="header">
    {{#if plantilla.logo_url}}<img src="{{plantilla.logo_url}}" alt="Logo">{{/if}}
    <h1>{{plantilla.encabezado}}</h1>
    <div class="form-titulo">{{formulario.titulo}}</div>
    {{#if formulario.descripcion}}<div class="form-descripcion">{{formulario.descripcion}}</div>{{/if}}
  </div>

  <div class="info-box">
    <strong>Estudiante:</strong> {{ficha.usuario.primer_nombre}} {{ficha.usuario.primer_apellido}} <br>
    <strong>Cédula:</strong> {{ficha.usuario.cedula}} <br>
    <strong>Periodo:</strong> {{ficha.periodo.nombre}} <br>
    <strong>Fecha de envío:</strong> {{formatDate ficha.created_at}} <br>
    <strong>Estado:</strong> {{ficha.estado_ficha}}
  </div>

  {{#if esFichaFinanciera}}
  <div class="info-box" style="border-left-color: {{plantilla.color_secundario}};">
    <strong>Total Ingresos:</strong> {{formatCurrency ficha.total_ingresos}} |
    <strong>Total Egresos:</strong> {{formatCurrency ficha.total_egresos}} <br>
    <strong>Balance Calculado:</strong> {{formatCurrency ficha.balance_final}} <br>
    <strong>Clasificación Asignada:</strong> {{#if ficha.rangoResultado}}{{ficha.rangoResultado.nombre}}{{else}}En evaluación{{/if}}
  </div>
  {{/if}}

  {{#if requiereAtencionSalud}}
  <div class="alert-box">
    <strong>⚠️ Atención Prioritaria (NEE / Salud):</strong><br>
    {{#if tieneDiscapacidad}} - Presenta carnet de discapacidad registrado.<br>{{/if}}
    {{#if usaLentes}} - Requiere apoyo visual (lentes).<br>{{/if}}
    {{#if enfermedadCronica}} - Condición médica reportada: {{enfermedadCronica}}<br>{{/if}}
  </div>
  {{/if}}

  {{#each secciones}}
  <h2>{{this.nombre}}</h2>
  {{#each this.preguntas}}
    <div class="pregunta">
      <b>{{this.enunciado}}</b>
      <div class="respuesta">{{{this.respuestaHtml}}}</div>
    </div>
  {{/each}}
  {{/each}}

  <div class="footer">{{plantilla.pie_pagina}}</div>
</body>
</html>