<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #334155; margin: 0; padding: 20px; }
        .header { text-align: center; border-bottom: 2px solid #e2e8f0; padding-bottom: 15px; margin-bottom: 20px; }
        .title { color: #1e3a8a; font-size: 20px; font-weight: bold; margin: 0 0 5px 0; }
        .subtitle { color: #64748b; font-size: 12px; margin: 0; }
        
        .grid-container { display: table; width: 100%; margin-bottom: 30px; }
        .col-datos { display: table-cell; width: 70%; vertical-align: top; padding-right: 20px; }
        .col-qr { display: table-cell; width: 30%; text-align: center; vertical-align: middle; }
        
        .section-title { font-size: 14px; color: #0f172a; border-bottom: 1px solid #cbd5e1; padding-bottom: 5px; margin-bottom: 10px; }
        .data-row { margin-bottom: 5px; font-size: 12px; }
        .data-label { font-weight: bold; color: #475569; }
        
        .qr-box { border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px; background: #fff; display: inline-block; }
        .qr-img { width: 140px; height: 140px; display: block; margin: 0 auto; }
        .qr-text { font-size: 10px; color: #64748b; margin-top: 8px; font-weight: bold; text-transform: uppercase; }

        .alert-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; }
        .alert-th { background-color: #ffe4e6; color: #9f1239; padding: 8px; text-align: left; border: 1px solid #fecdd3; }
        .alert-td-q { padding: 8px; border: 1px solid #fecdd3; font-weight: bold; color: #334155; width: 60%; }
        .alert-td-a { padding: 8px; border: 1px solid #fecdd3; color: #be123c; font-weight: bold; width: 40%; }
        .no-alerts { padding: 15px; background: #f8fafc; border: 1px solid #e2e8f0; color: #475569; font-size: 12px; border-radius: 6px; }
    </style>
</head>
<body>

    <div class="header">
        <h1 class="title">RESUMEN DE FICHA SOCIOECONÓMICA</h1>
        <p class="subtitle">Instituto Superior Tecnológico del Azuay - Bienestar Estudiantil</p>
        <p class="subtitle" style="margin-top: 5px;">Generado el: {{fechaGeneracion}}</p>
    </div>

    <div class="grid-container">
        <div class="col-datos">
            <h2 class="section-title">Datos del Estudiante</h2>
            <div class="data-row"><span class="data-label">Nombres:</span> {{ficha.usuario.primer_nombre}} {{ficha.usuario.segundo_nombre}}</div>
            <div class="data-row"><span class="data-label">Apellidos:</span> {{ficha.usuario.primer_apellido}} {{ficha.usuario.segundo_apellido}}</div>
            <div class="data-row"><span class="data-label">Cédula:</span> {{ficha.usuario.cedula}}</div>
            <div class="data-row"><span class="data-label">Correo Institucional:</span> {{ficha.usuario.email_institucional}}</div>
            
            <h2 class="section-title" style="margin-top: 20px;">Resumen Financiero Declarado</h2>
            <div class="data-row"><span class="data-label">Ingresos Totales:</span> ${{ficha.total_ingresos}}</div>
            <div class="data-row"><span class="data-label">Egresos Totales:</span> ${{ficha.total_egresos}}</div>
            <div class="data-row"><span class="data-label">Balance Final:</span> ${{ficha.balance_final}}</div>
        </div>
        
        <div class="col-qr">
            <div class="qr-box">
                <img src="{{qrCode}}" alt="Código QR" class="qr-img">
                <p class="qr-text">Escanear para ver<br>ficha completa</p>
            </div>
        </div>
    </div>

    <h2 class="section-title" style="color: #9f1239; border-bottom-color: #fecdd3;">
        Puntos de Atención Prioritaria
    </h2>
    
    {{#if alertasVulnerabilidad.length}}
        <table class="alert-table">
            <thead>
                <tr>
                    <th class="alert-th">Criterio de Vulnerabilidad</th>
                    <th class="alert-th">Respuesta</th>
                </tr>
            </thead>
            <tbody>
                {{#each alertasVulnerabilidad}}
                <tr>
                    <td class="alert-td-q">{{this.pregunta}}</td>
                    <td class="alert-td-a">{{this.respuesta}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <div class="no-alerts">
            No se detectaron alertas de vulnerabilidad de revisión manual obligatoria en las respuestas del estudiante.
        </div>
    {{/if}}

</body>
</html>